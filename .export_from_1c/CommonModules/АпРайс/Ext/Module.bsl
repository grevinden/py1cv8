	//### Объяснение кодов ответа Apprise API

	//Это стандартные HTTP-коды состояния, которые сервер возвращает клиенту. Если запросить ответ в формате JSON (заголовок `Accept: application/json`), ошибки будут содержать поле `error` с описанием.

	//Разберу по группам:

	//---

	//### ✅ Успешные коды

	//| Код     | Значение        | Когда появляется                                                 |
	//|---------|-----------------|------------------------------------------------------------------|
	//| **200** | Успешно         | Запрос выполнен корректно                                        |
	//| **204** | Нет содержимого | Два случая: либо по запрошенному ключу нет конфигурации, либо    |
	//                            | stateless-уведомление не имело ни одного валидного URL для       |
	//                            | отправки                                                         |

	//---

	//### ❌ Ошибки клиента (4xx)

	//| Код     | Значение                     | Когда появляется |
	//|---------|------------------------------|------------------|
	//| **400** | Неверный запрос              | Несколько возможных причин: некорректный JSON в теле запроса, неподдерживаемый тип/формат, неверное определение тега, неверный заголовок рекурсии, или правило маппинга полей (`:source=target`) не сработало (например, путь через точку не найден в данных или превышена максимальная глубина) |
	//| **403** | Запрещено                    | Сервер настроен отклонять запрос. Например, включена блокировка конфигурации (`APPRISE_CONFIG_LOCK=yes`) или отключён просмотр `/cfg` |
	//| **405** | Метод не разрешён            | Использован неподдерживаемый HTTP-метод для данного эндпоинта (например, POST вместо GET) |
	//| **406** | Неприемлемо                  | Достигнут лимит рекурсии, либо запрос отклонён серверным правилом |
	//| **417** | Ожидание не удалось          | Проверка здоровья обнаружила блокирующее условие (например, отсутствуют права на запись) |
	//| **421** | Ошибочно направленный запрос | Включён режим «только API», но клиент запросил страницу веб-интерфейса |
	//| **424** | Неудачная зависимость        | Хотя бы одно уведомление не удалось отправить |
	//| **431** | Слишком большие заголовки    | Размер запроса превысил лимит загрузки в памяти, Django отклонил его |

	//---

	//###  Ошибки сервера (5xx)

	//| Код     | Значение                  | Когда появляется |
	//|---------|---------------------------|------------------|
	//| **500** | Внутренняя ошибка сервера | Ошибка на стороне сервера: сбой сохранения/загрузки конфигурации или неожиданная ошибка ввода-вывода |

	//---

	//### Потенциально неочевидные моменты

	//1. **400** — самая «разнообразная» ошибка. Если видите её — проверяйте структуру payload, корректность dot-notation в маппинге и заголовки.

	//2. **424** — ключевая ошибка для систем уведомлений. Даже если часть уведомлений ушла успешно, этот код сигнализирует, что минимум одна доставка провалилась. Нужно проверять детали в теле ответа.

	//3. **417** — специфична для health-check эндпоинтов. Не просто «сервер жив», а «сервер жив и работоспособен». Отсутствие прав на запись — частая причина в контейнеризированных средах.

Функция НовоеСообщение(Канал,Текст,КакJSON=Ложь) Экспорт
	urls = Новый Массив(1);
	urls[0] = ОбработкаАлгоритмов.ВыполнитьАлгоримФормированияСсылки(Канал);
	Результат = Новый ФиксированнаяСтруктура("urls,body",Новый ФиксированныйМассив(urls),Текст);
	Возврат ?(КакJSON,ЗаписатьЗначениеJSON(Результат),Результат);
КонецФункции

Функция СоздатьСессию() Экспорт
	Клиент = ирОбщий.ОбщийМодульЛкс("КоннекторHTTP");
	Результат = Клиент.СоздатьСессию();
	Результат.ПараметрыЗапроса = Новый Структура("upstream",Константы.АдресШлюзаСообщений.Получить());
	Возврат Результат;
КонецФункции

Функция СоздатьПараметры() Экспорт
	Клиент = ирОбщий.ОбщийМодульЛкс("КоннекторHTTP");
	Результат = Клиент.НовыеПараметры();
	Результат.Таймаут = 3;
	Результат.ПовторятьДляКодовСостояний = ирОбщий.ЗначенияВМассивЛкс(503);
	Результат.КоэффициентЭкспоненциальнойЗадержки = 1;
	Результат.МаксимальноеКоличествоПовторов = 3;
	Результат.МаксимальноеВремяПовторов = 10;
	Результат.ПараметрыПреобразованияJSON.ПрочитатьВСоответствие = Ложь;
	Возврат Результат;
КонецФункции

Функция ОтправитьСообщение(Сообщение) Экспорт

	Клиент = ирОбщий.ОбщийМодульЛкс("КоннекторHTTP");

	Сессия = СоздатьСессию();
	Параметры = СоздатьПараметры();
	Параметры.Json = Сообщение;

	Ответ = Клиент.Post(Константы.АдресТерминатораШифрования.Получить(),,Параметры,Сессия);

	system_id = Ответ.Заголовки.Получить("x-system-id");
	upstream_status = Ответ.Заголовки.Получить("x-upstream-status");

	Если system_id = "msgw" Тогда
		ВызватьИсключение(Клиент.КакТекст(Ответ));

	Иначе
		Если upstream_status = "unhealthy" Тогда
			ВызватьИсключение(Клиент.КакJson(Ответ,Параметры.ПараметрыПреобразованияJSON).detail);

		ИначеЕсли upstream_status = "healthy" Тогда
			Если system_id = "upstream" Тогда
				Если Ответ.КодСостояния = 200 Тогда
					Возврат Истина;
				ИначеЕсли Ответ.КодСостояния = 204 Тогда
					ВызватьИсключение "Не удалось отправить сообщение чтото с самим сообщением";
				Иначе
					ВызватьИсключение Клиент.КакИсключение(Ответ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение "Тыт мы не должны оказаться";
КонецФункции
