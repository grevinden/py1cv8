&НаСервере
Функция Ключ()
	Результат = Константы.КлючШифрования.Получить();
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Секрет = "";
	Форма = ПараметрыВыполненияКоманды.Источник;
	Если ВвестиСтроку(Секрет,"Значение которое необходимо зашифровать",,Истина) Тогда
		Оповестить("Шифрование",OPI_ECIES.Зашифровать(Секрет, Ключ()), Форма);
	КонецЕсли;
КонецПроцедуры
