[
  {
    "label": "py1cv8: MCP сервер",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "py1cv8",
    "args": ["mcp", "--db-url", "${env:PY1CV8_DB_URL}"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "PY1CV8_DB_URL": "",
    },
    "justMyCode": true,
  },
  {
    "label": "py1cv8: Schema summary",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "py1cv8",
    "args": ["schema", "--db-url", "${env:PY1CV8_DB_URL}"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "PY1CV8_DB_URL": "postgresql+psycopg2://postgres@localhost:5433/test",
    },
    "justMyCode": true,
  },
  {
    "label": "py1cv8: CLI (help)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "py1cv8",
    "args": ["--help"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true,
  },
  {
    "label": "pytest: все тесты",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["tests/", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true,
  },
  {
    "label": "pytest: текущий файл",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": true,
  },
  {
    "adapter": "Debugpy",
    "label": "pytest 'B:\\py1cv8\\src\\py1cv8\\db.py'",
    "request": "launch",
    "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
    "args": ["\"$ZED_FILE\""],
    "cwd": "$ZED_WORKTREE_ROOT",
    "module": "pytest",
  },
]
