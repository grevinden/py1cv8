# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg
*.egg-info/
*.whl
.eggs/

# ── Build artifacts ─────────────────────────────────────────────────────────
dist/
build/
*.patch
*.cover
*.orig
*.bak

# ── Virtual environments ────────────────────────────────────────────────────
venv/
.venv/
env/

# ── IDE (launch/debug configs tracked explicitly) ───────────────────────────
.vscode/*
!.vscode/launch.json
.idea/*
!.idea/runConfigurations/
.zed/*
!.zed/debug.json
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

