.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Research artifacts ──────────────────────────────────────────────────────
.staff/

# ── Temp / scratch ──────────────────────────────────────────────────────────
Temp/

# ── Binary form files in 1C export subdirectories ───────────────────────────
*.bin

